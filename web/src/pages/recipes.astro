---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import RecipesTable from '../components/RecipesTable';
import { openDb, listRuns, recipeRows, professionSummary, priceSourceFor } from '../lib/db';

const db = openDb();
const runs = db ? listRuns(db) : [];
const wanted = Astro.url.searchParams.get('run');
const run = runs.find((r) => r.label === wanted) ?? runs[0];
const recipes = db && run ? recipeRows(db, run.id) : [];
const professions = db && run ? professionSummary(db, run.id) : [];
const priceSrc = db && run ? priceSourceFor(db, run.id) : null;
db?.close();
const names = [...new Set(recipes.map((r) => r.profession))].sort();
---

<Layout title="Recipes">
  <main class="mx-auto max-w-6xl px-6 pt-32 pb-24">
    <SectionHeader
      title="Recipes"
      subtitle="Learned and not-yet-learned recipes per profession, with their reagents and what you already carry."
    />

    {!run ? (
      <div class="rounded border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] p-6 opacity-60">
        No runs yet. Run <code>scripts/new-run.sh &lt;SavedVariables file&gt;</code> first.
      </div>
    ) : (
      <>
        <section class="mb-8 grid grid-cols-2 gap-6 md:grid-cols-5">
          {professions.map((p) => (
            <div class="flex flex-col gap-2 rounded border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-colors duration-200 hover:border-[var(--color-accent-gold)]">
              <span class="font-heading text-xs tracking-widest uppercase text-[var(--color-text-muted)]">{p.name}</span>
              <span class="font-heading text-lg font-semibold">{p.skill ?? '—'} / {p.max_skill ?? '—'}</span>
              <span class="text-sm text-[var(--color-text-muted)]">{p.learned} / {p.recipes} recipes learned</span>
            </div>
          ))}
        </section>

        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
          <label class="flex items-center gap-2 font-heading text-xs tracking-widest uppercase text-[var(--color-text-muted)]">
            Run
            <select
              id="run-select"
              class="rounded border border-[var(--color-border)] bg-[var(--color-surface)] px-2 py-1 text-[var(--color-text)]"
            >
              {runs.map((r) => (
                <option value={r.label} selected={r.id === run.id}>{r.label}</option>
              ))}
            </select>
          </label>
        </div>
        {priceSrc && priceSrc.id !== run.id && (
          <p class="mb-6 rounded border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-sm text-[var(--color-text-muted)]">
            This run has no Auction House scan. AH prices shown come from the scan of <span class="text-[var(--color-text)]">{priceSrc.label}</span> ({priceSrc.scan_time}).
          </p>
        )}
        {!priceSrc && (
          <p class="mb-6 rounded border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-sm text-[var(--color-text-muted)]">
            No Auction House scan has been ingested yet, so there are no AH prices.
          </p>
        )}
        <RecipesTable client:load recipes={recipes} professions={names} />
      </>
    )}
  </main>
</Layout>

<script>
  document.getElementById('run-select')?.addEventListener('change', (e) => {
    const label = (e.target as HTMLSelectElement).value;
    window.location.search = `?run=${encodeURIComponent(label)}`;
  });
</script>
