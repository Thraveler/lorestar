---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="mb-10 text-center">
  <h2 class="font-heading text-3xl font-bold text-[var(--color-text)]">{title}</h2>
  <div class="mt-3 flex items-center justify-center gap-3 text-[var(--color-accent-gold)]" aria-hidden="true">
    <span class="h-px w-16 bg-[var(--color-accent-gold)]"></span>
    <span>✦</span>
    <span class="h-px w-16 bg-[var(--color-accent-gold)]"></span>
  </div>
  {subtitle && <p class="mx-auto mt-4 max-w-xl text-[var(--color-text-muted)]">{subtitle}</p>}
</div>
